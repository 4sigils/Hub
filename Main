local PlaceId = game.PlaceId

local Games = {
    Strikeborn = {
        [80167904212435] = true,
        [73682082940624] = true,
    },

    Plenilune = {
        [18563654875] = true,
        [2] = true,
    },
}

if Games.Strikeborn[PlaceId] then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/4sigils/Hub/refs/heads/main/StrikebornAutoPB.lua"))()

elseif Games.Plenilune[PlaceId] then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/4sigils/Hub/refs/heads/main/PleniluneAP.lua"))()

else
    warn("Unsupported PlaceId:", PlaceId)
end
